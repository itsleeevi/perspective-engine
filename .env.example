# Perspective Engine — environment variable NAMES only. Never commit secrets.
#
# Documentary channel/ TTS: Gemini 3.1 Flash TTS when GEMINI_API_KEY is set.
# Operator-imported audio still works without it. Do not silently fall back
# to ElevenLabs / Edge / Kokoro on new jobs.
#
# The names below that say graph Phase-2 are unused on the YouTube path.

# Gemini 3.1 Flash TTS (channel/ — python -m channel tts)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# LangSmith tracing (graph Phase 3+)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=

# Script / quality-gate LLM (graph Phase 2+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image / video via fal.ai (graph Phase 2+ only — not channel/)
FAL_KEY=

# ElevenLabs (graph Phase 2+ only — channel/ forbids this)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Publishing (graph Phase 4+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
