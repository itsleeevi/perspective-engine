# Perspective Engine — environment variable NAMES only. Never commit secrets.
#
# Documentary channel/ TTS: Gemini 3.1 Flash TTS when GEMINI_API_KEY is set.
# Opt-in stills: python -m channel images (Nano Banana 2 / gemini-3.1-flash-image)
# when the same key is set. Opt-in clips: python -m channel videos
# (Omni 1.1 Flash / gemini-omni-1.1-flash) after stills exist. Opt-in music:
# python -m channel music (Lyria 3 / lyria-3-clip-preview) after QA. Operator
# Google Flow ingest still works without it. Do not silently fall back to
# ElevenLabs / Edge / Kokoro / fal / OpenAI Images / Seedance / Suno on new jobs.
#
# The names below that say graph Phase-2 are unused on the YouTube path.

# Gemini 3.1 Flash TTS (channel/ — python -m channel tts)
# Nano Banana 2 stills (channel/ — python -m channel images; also graph --image-provider)
# Omni 1.1 Flash clips (channel/ — python -m channel videos; also graph --video-provider)
# Lyria 3 background music (channel/ — python -m channel music)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# LangSmith tracing (graph Phase 3+)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=

# Script / quality-gate LLM (graph Phase 2+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image / video via fal.ai (graph Phase 2+ only — not channel/)
FAL_KEY=

# ElevenLabs (graph Phase 2+ only — channel/ forbids this)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Publishing (graph Phase 4+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
