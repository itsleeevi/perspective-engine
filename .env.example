# Perspective Engine — environment variable NAMES only. Never commit secrets.
#
# The YouTube documentary path (channel/ + Cursor GenerateImage + Kokoro)
# does NOT read these keys. If GenerateImage or Kokoro is missing, STOP.
# Do not silently fall back to fal / OpenAI images / ElevenLabs / Edge.
#
# The names below are for the unused graph/ Phase-2 adapters only.

# LangSmith tracing (graph Phase 3+)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=

# Script / quality-gate LLM (graph Phase 2+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image / video via fal.ai (graph Phase 2+ only — not channel/)
FAL_KEY=

# ElevenLabs (graph Phase 2+ only — channel/ forbids this)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Publishing (graph Phase 4+)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
